# Normalise line endings so the repo is identical on Windows and Unix.
# Without this, a Windows checkout rewrites every file to CRLF and the plugin's
# own git checkpoints show the whole project as modified on the first run.
* text=auto eol=lf

# Windows-native files keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.sln  text eol=crlf
*.vcxproj text eol=crlf

# Binaries git must not touch.
*.png  binary
*.jpg  binary
*.ico  binary
*.so   binary
*.dll  binary
*.dylib binary
*.lib  binary
*.a    binary
*.pdb  binary
*.res  binary
*.import linguist-generated
